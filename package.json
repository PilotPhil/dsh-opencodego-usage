{
  "name": "@pilot12138/dsh-opencodego-usage",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek Harness plugin: shows the remaining OpenCode Go allowance (5-hour, weekly, monthly) as a card in the sidebar, plus an opencode_go_quota agent tool.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "quota",
    "usage",
    "widget"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PilotPhil/@pilot12138/dsh-opencodego-usage.git"
  },
  "homepage": "https://github.com/PilotPhil/@pilot12138/dsh-opencodego-usage#readme",
  "bugs": {
    "url": "https://github.com/PilotPhil/@pilot12138/dsh-opencodego-usage/issues"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
